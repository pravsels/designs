.DS_Store
__pycache__/

# Generated artifacts: a model script rebuilds them, so only the source is
# tracked. Matched at any depth, since each design owns its own format folders.
# The imported/ exceptions keep hand-supplied inputs.
**/STEP/*
!**/STEP/imported/
**/GLB/*
!**/GLB/imported/
**/STL/*
!**/STL/imported/
*.py[cod]
.venv/
.env
.env.*
*.tmp
tmp/
